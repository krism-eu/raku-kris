[rakuos]
name=RakuOS Development Repository
baseurl=https://rakuos.krisv.com/repos/rakuos
enabled=1
gpgcheck=0
# WARNING: gpgcheck=0 is for DEVELOPMENT ONLY.
# Production builds MUST enable GPG verification with gpgcheck=1 and gpgkey=...
# See README.md section "Important trust distinction".
skip_if_unavailable=True
