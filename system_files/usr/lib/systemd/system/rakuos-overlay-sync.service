[Unit]
Description=Sync RakuOS Overlay State
Documentation=man:rakuos(8)
After=rakuos-overlay-mount.service
Requires=rakuos-overlay-mount.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/rakuos/rakuos-overlay-sync
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
