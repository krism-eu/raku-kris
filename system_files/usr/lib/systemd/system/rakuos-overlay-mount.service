[Unit]
Description=Mount RakuOS Persistent Overlay
Documentation=man:rakuos(8)
DefaultDependencies=no
After=local-fs-pre.target
Before=local-fs.target
Wants=local-fs-pre.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/rakuos/rakuos-overlay-mount
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

# IMPORTANT: This service is a scaffold implementation.
# Production builds should use a real overlay mechanism (partition, composefs, or ostree native).
# Current implementation uses tmpfs for development/testing compatibility.

[Install]
WantedBy=local-fs.target
