[Unit]
Description=Start RakuOS Overlay Services
Documentation=man:rakuos(8)
After=rakuos-overlay-mount.service
Requires=rakuos-overlay-mount.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/rakuos/rakuos-overlay-services
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
