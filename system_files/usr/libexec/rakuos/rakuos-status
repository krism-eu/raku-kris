#!/usr/bin/env bash
set -Eeuo pipefail

# Show overlay and base image status

OVERLAY_MOUNT="/var/rakuos-overlay"

echo "=== Raku Kris Status ==="
echo ""

# Base image status
if command -v bootc >/dev/null 2>&1; then
    echo "Base Image:"
    bootc status 2>/dev/null || echo "  bootc status unavailable"
else
    echo "Base Image: bootc not available"
fi
echo ""

# Overlay status
if [[ -d "$OVERLAY_MOUNT" ]]; then
    echo "Overlay: mounted at $OVERLAY_MOUNT"
    
    # Count installed packages in overlay
    if [[ -d "$OVERLAY_MOUNT/var/lib/rpm" ]]; then
        pkg_count=$(find "$OVERLAY_MOUNT/var/lib/rpm/Packages" -type f 2>/dev/null | wc -l || echo "0")
        echo "  Packages in overlay: $pkg_count"
    else
        echo "  Packages in overlay: 0 (no rpm database)"
    fi
else
    echo "Overlay: NOT mounted"
    echo "  Expected at: $OVERLAY_MOUNT"
    echo "  Check rakuos-overlay-mount.service status"
fi
echo ""

# dnf5.real availability
if command -v dnf5.real >/dev/null 2>&1; then
    echo "Backend: dnf5.real available"
    dnf5.real --version 2>/dev/null | head -1 || true
else
    echo "Backend: dnf5.real NOT available"
fi
