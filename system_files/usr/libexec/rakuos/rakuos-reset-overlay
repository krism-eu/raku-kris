#!/usr/bin/env bash
set -Eeuo pipefail

# Reset the persistent overlay to factory state
# WARNING: This removes ALL packages installed via rakuos install

OVERLAY_MOUNT="/var/rakuos-overlay"
STATE_FILE="$OVERLAY_MOUNT/.rakuos-overlay-state"

echo "WARNING: This will reset the persistent overlay to factory state."
echo "All packages installed via 'rakuos install' will be removed."
echo ""

if [[ ! -d "$OVERLAY_MOUNT" ]]; then
    echo "ERROR: Overlay not mounted at $OVERLAY_MOUNT" >&2
    echo "The overlay should be mounted by rakuos-overlay-mount.service at boot." >&2
    exit 1
fi

read -p "Type 'RESET' to confirm: " confirm
if [[ "$confirm" != "RESET" ]]; then
    echo "Reset cancelled."
    exit 0
fi

echo "Resetting overlay..."

# Remove overlay state tracking
rm -f "$STATE_FILE"

# Clear overlay package database
if [[ -d "$OVERLAY_MOUNT/var/lib/rpm" ]]; then
    rm -rf "$OVERLAY_MOUNT/var/lib/rpm"/*
fi

if [[ -d "$OVERLAY_MOUNT/var/cache/dnf" ]]; then
    rm -rf "$OVERLAY_MOUNT/var/cache/dnf"/*
fi

# Remove installed packages from overlay
if [[ -d "$OVERLAY_MOUNT/usr" ]]; then
    # Preserve overlay structure but remove package content
    find "$OVERLAY_MOUNT/usr" -mindepth 1 -delete 2>/dev/null || true
fi

echo "Overlay reset complete."
echo "Changes will take effect after reboot."
