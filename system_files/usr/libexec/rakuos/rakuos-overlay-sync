#!/usr/bin/env bash
set -Eeuo pipefail

# Sync overlay state with base image
# Called after base image updates to reconcile overlay packages
#
# This script handles the case where:
# - Base image update may have changed system libraries
# - Overlay packages may need to be revalidated or rebuilt
# - Symlinks between base and overlay need updating

OVERLAY_MOUNT="/var/rakuos-overlay"
BASE_ROOT="/usr"

echo "Syncing overlay state with base image..."

# Verify overlay is mounted
if [[ ! -d "$OVERLAY_MOUNT" ]]; then
    echo "ERROR: Overlay not mounted at $OVERLAY_MOUNT" >&2
    exit 1
fi

# Verify base root exists
if [[ ! -d "$BASE_ROOT" ]]; then
    echo "ERROR: Base root not found at $BASE_ROOT" >&2
    exit 1
fi

# Sync strategy: ensure overlay directories exist and are writable
# In a real implementation, this would:
# 1. Check for broken symlinks
# 2. Rebuild packages that depend on changed libraries
# 3. Update overlay manifest

# Ensure overlay structure
mkdir -p "$OVERLAY_MOUNT/usr"
mkdir -p "$OVERLAY_MOUNT/var/lib/rpm"
mkdir -p "$OVERLAY_MOUNT/var/cache/dnf"

# Create sync timestamp
echo "$(date -Iseconds)" > "$OVERLAY_MOUNT/.rakuos-overlay-synced"

echo "Overlay sync complete"
