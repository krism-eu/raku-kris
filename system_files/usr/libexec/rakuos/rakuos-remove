#!/usr/bin/env bash
set -Eeuo pipefail

# Remove packages from the persistent overlay
# Usage: rakuos-remove <package> [package...]

if [[ $# -eq 0 ]]; then
    echo "ERROR: No packages specified." >&2
    echo "Usage: rakuos-remove <package> [package...]" >&2
    exit 1
fi

# Verify dnf5.real is available
if ! command -v dnf5.real >/dev/null 2>&1; then
    echo "ERROR: dnf5.real not found. RakuOS runtime not initialized." >&2
    exit 1
fi

# Remove packages using dnf5.real
exec dnf5.real remove "$@"
