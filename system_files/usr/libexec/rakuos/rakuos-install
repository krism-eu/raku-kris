#!/usr/bin/env bash
set -Eeuo pipefail

# Install packages into the persistent overlay
# Usage: rakuos-install <package> [package...]

if [[ $# -eq 0 ]]; then
    echo "ERROR: No packages specified." >&2
    echo "Usage: rakuos-install <package> [package...]" >&2
    exit 1
fi

# Verify dnf5.real is available
if ! command -v dnf5.real >/dev/null 2>&1; then
    echo "ERROR: dnf5.real not found. RakuOS runtime not initialized." >&2
    exit 1
fi

# Install packages using dnf5.real
# The overlay is mounted at /var/rakuos-overlay by rakuos-overlay-mount.service
# dnf5.real is configured to install into this overlay root
exec dnf5.real install "$@"
