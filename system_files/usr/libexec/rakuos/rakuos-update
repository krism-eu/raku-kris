#!/usr/bin/env bash
set -Eeuo pipefail

# Update the base image via bootc
# This updates the immutable base layer, not the overlay packages

if ! command -v bootc >/dev/null 2>&1; then
    echo "ERROR: bootc not found. This system may not be bootc-managed." >&2
    exit 1
fi

# Check for updates
if bootc upgrade --check 2>/dev/null; then
    echo "Updates available. Run 'bootc upgrade' to apply."
else
    echo "Base image is up to date."
fi
