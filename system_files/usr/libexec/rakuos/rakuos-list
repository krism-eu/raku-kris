#!/usr/bin/env bash
set -Eeuo pipefail

# List packages installed in the persistent overlay

if ! command -v dnf5.real >/dev/null 2>&1; then
    echo "ERROR: dnf5.real not found. RakuOS runtime not initialized." >&2
    exit 1
fi

# List installed packages from overlay
# Filter to show only overlay-installed packages if possible
dnf5.real list --installed
