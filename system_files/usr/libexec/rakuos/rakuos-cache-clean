#!/usr/bin/env bash
set -Eeuo pipefail

# Clean package manager caches

echo "Cleaning package caches..."

# Clean dnf5.real cache
if command -v dnf5.real >/dev/null 2>&1; then
    dnf5.real clean all 2>/dev/null || true
fi

# Clean overlay cache
OVERLAY_MOUNT="/var/rakuos-overlay"
if [[ -d "$OVERLAY_MOUNT/var/cache/dnf" ]]; then
    rm -rf "$OVERLAY_MOUNT/var/cache/dnf"/*
fi

# Clean system cache
rm -rf /var/cache/dnf/* 2>/dev/null || true

echo "Cache clean complete"
